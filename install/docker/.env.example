# =============================================================================
# OpenFang Docker Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# IMPORTANT: Use absolute paths — shell variables like $HOME are NOT expanded
# inside .env files.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d --build

# =============================================================================
# PATHS — Persistent state storage
# =============================================================================

# Root directory for all agent state on the host.
# Every container in the agent-phi ecosystem stores its state under this root.
# Example: /home/alice/agent-phi/state
STATE_BASE_PATH=/home/user/agent-phi/state

# OpenFang home directory on the host.
# Mounted into the container as /data (OPENFANG_HOME=/data).
# Contains: config.toml, data/openfang.db, agents/, skills/, custom_models.json
# Must be an absolute path.
OPENFANG_STATE_PATH=/home/user/agent-phi/state/openfang

# =============================================================================
# NETWORK — Shared agent network
# =============================================================================

# Name of the shared Docker bridge network.
# All subcomponent containers (qmd, paperclip, other runtimes) should join
# this same network so they can reach each other by service name.
#
# Other docker-compose stacks can attach to this network with:
#   networks:
#     agent-net:
#       name: ${AGENT_NETWORK}   # must match this value
#       external: true
AGENT_NETWORK=agent-phi

# =============================================================================
# PORTS
# =============================================================================

# Host port for the OpenFang HTTP/WS/SSE API.
# Internally the container always listens on 4200.
OPENFANG_PORT=4200

# =============================================================================
# OPENFANG RUNTIME
# =============================================================================

# Bind address inside the container. Change to 127.0.0.1:4200 to restrict
# access to localhost (useful when accessed via reverse proxy on the host).
OPENFANG_API_LISTEN=0.0.0.0:4200

# Log level: trace | debug | info | warn | error
OPENFANG_LOG_LEVEL=info

# Optional: static API bearer token to authenticate all API requests.
# Leave empty to run unauthenticated (local / private network only).
OPENFANG_API_KEY=

# =============================================================================
# LLM PROVIDER API KEYS
# =============================================================================
# Set at least one. The first one found (in provider priority order) is used.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
COHERE_API_KEY=
XAI_API_KEY=

# =============================================================================
# WEB SEARCH API KEYS (optional)
# =============================================================================

BRAVE_API_KEY=
TAVILY_API_KEY=

# =============================================================================
# CHANNEL ADAPTER TOKENS (optional)
# =============================================================================

TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
MATRIX_ACCESS_TOKEN=
TEAMS_APP_PASSWORD=
MATTERMOST_TOKEN=
